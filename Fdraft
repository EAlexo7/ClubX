<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>9jaNova â€“ Elevate Your Nightlife</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;400&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #0a1633;
      --primary-dark: #07102a;
      --secondary: #1e2a4a;
      --accent: #3a5ca8;
      --accent-light: #5e7fcf;
      --white: #fff;
      --muted: #bfc8db;
      --gradient: linear-gradient(135deg, #3a5ca8 0%, #5e7fcf 100%);
    }
    * {margin: 0; padding: 0; box-sizing: border-box;}
    body {
      font-family: 'Montserrat', Arial, sans-serif;
      background: var(--primary-dark);
      color: var(--white);
      min-height: 100vh;
      line-height: 1.6;
    }
    a {color: inherit; text-decoration: none;}
    nav {
      width: 100%;
      padding: 24px 48px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: fixed;
      top: 0;
      left: 0;
      background: rgba(10,22,51,0.92);
      backdrop-filter: blur(8px);
      z-index: 1000;
      transition: background 0.3s;
    }
    .logo {
      font-size: 2rem;
      font-weight: 700;
      color: var(--white);
      letter-spacing: 2px;
    }
    nav ul {
      list-style: none;
      display: flex;
      gap: 32px;
      align-items: center;
    }
    nav ul li a {
      font-weight: 600;
      font-size: 1rem;
      color: var(--white);
      transition: color .3s;
      padding: 6px 0;
      border-bottom: 2px solid transparent;
    }
    nav ul li a:hover, nav ul li.active a {
      color: var(--accent);
      border-bottom: 2px solid var(--accent);
    }
    .nav-cta {
      background: var(--accent);
      color: var(--white);
      padding: 10px 28px;
      border-radius: 24px;
      font-weight: 700;
      font-size: 1rem;
      border: none;
      cursor: pointer;
      margin-left: 18px;
      transition: background 0.2s;
    }
    .nav-cta:hover {
      background: var(--accent-light);
      color: var(--white);
    }
    /* Hero */
    .hero {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      background: var(--primary-dark);
      position: relative;
      padding-top: 120px;
      padding-bottom: 60px;
    }
    .hero-bg {
      position: absolute;
      inset: 0;
      background: var(--gradient);
      opacity: 0.18;
      z-index: 0;
    }
    .hero-content {
      position: relative;
      z-index: 1;
      max-width: 700px;
      margin: 0 auto;
      padding: 32px 16px;
    }
    .hero-content h1 {
      font-size: 3rem;
      font-weight: 700;
      margin-bottom: 18px;
      color: var(--white);
      letter-spacing: 1px;
    }
    .hero-content p {
      font-size: 1.25rem;
      color: var(--muted);
      margin-bottom: 32px;
      font-weight: 400;
    }
    .app-downloads {
      display: flex;
      justify-content: center;
      gap: 18px;
      margin-bottom: 32px;
      flex-wrap: wrap;
    }
    .app-btn {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--accent);
      color: var(--white);
      padding: 16px 36px;
      border-radius: 28px;
      font-weight: 700;
      font-size: 1.1rem;
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 24px 0 rgba(58,92,168,0.15);
      transition: background 0.2s;
      text-decoration: none;
    }
    .app-btn img {
      height: 28px;
      width: auto;
    }
    .app-btn:hover {
      background: var(--accent-light);
    }
    .venue-cta {
      margin-top: 18px;
      display: inline-block;
      background: var(--white);
      color: var(--accent);
      padding: 14px 38px;
      border-radius: 32px;
      font-weight: 700;
      font-size: 1.1rem;
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 24px 0 rgba(58,92,168,0.10);
      transition: background 0.2s, color 0.2s;
      text-decoration: none;
    }
    .venue-cta:hover {
      background: var(--accent);
      color: var(--white);
    }
    /* Features */
    .features {
      display: flex;
      gap: 40px;
      justify-content: center;
      flex-wrap: wrap;
      margin: 60px auto 0 auto;
      max-width: 1100px;
    }
    .feature-card {
      background: var(--secondary);
      border-radius: 16px;
      padding: 32px 24px;
      flex: 1 1 220px;
      max-width: 320px;
      box-shadow: 0 2px 12px 0 rgba(10,22,51,0.08);
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      margin-bottom: 24px;
    }
    .feature-icon {
      font-size: 2.5rem;
      margin-bottom: 18px;
      color: var(--accent);
    }
    .feature-title {
      font-size: 1.2rem;
      font-weight: 700;
      margin-bottom: 10px;
      color: var(--white);
    }
    .feature-desc {
      color: var(--muted);
      font-size: 1rem;
    }
    /* Carousel */
    .club-carousel {
      display: flex;
      gap: 24px;
      overflow-x: auto;
      padding: 20px 0;
      scroll-snap-type: x mandatory;
      justify-content: center;
      margin-top: 36px;
    }
    .club-card {
      flex: 0 0 auto;
      min-width: 240px;
      background: var(--secondary);
      border-radius: 12px;
      padding: 18px;
      scroll-snap-align: start;
      box-shadow: 0 2px 12px 0 rgba(10,22,51,0.10);
      text-align: left;
      transition: transform 0.2s;
    }
    .club-card:hover {
      transform: translateY(-8px) scale(1.03);
    }
    .club-card img {
      width: 100%;
      border-radius: 8px;
      margin-bottom: 12px;
      height: 140px;
      object-fit: cover;
    }
    .club-card h3 {
      color: var(--white);
      font-size: 1.1rem;
      margin-bottom: 6px;
    }
    .club-card p {
      color: var(--muted);
      font-size: 0.98rem;
      margin-bottom: 10px;
    }
    .club-card button {
      padding: 8px 20px;
      background: var(--accent);
      border: none;
      border-radius: 6px;
      cursor: pointer;
      color: var(--white);
      font-weight: 600;
      font-size: 1rem;
      transition: background 0.2s;
    }
    .club-card button:hover {
      background: var(--accent-light);
      color: var(--white);
    }
    /* Testimonials */
    .testimonials {
      display: flex;
      gap: 32px;
      justify-content: center;
      flex-wrap: wrap;
      margin-top: 36px;
    }
    .testimonial {
      background: var(--secondary);
      border-radius: 16px;
      padding: 28px 22px;
      max-width: 320px;
      box-shadow: 0 2px 12px 0 rgba(10,22,51,0.10);
      text-align: left;
      position: relative;
    }
    .testimonial::before {
      content: "â€œ";
      font-size: 3rem;
      color: var(--accent);
      position: absolute;
      left: 18px;
      top: 8px;
      opacity: 0.15;
    }
    .testimonial-text {
      color: var(--muted);
      font-size: 1.05rem;
      margin-bottom: 18px;
      margin-top: 8px;
    }
    .testimonial-user {
      font-weight: 700;
      color: var(--white);
      font-size: 1rem;
    }
    /* Footer */
    footer {
      background: var(--primary-dark);
      padding: 36px 20px 24px 20px;
      text-align: center;
      border-top: 1px solid var(--secondary);
      color: var(--muted);
      font-size: 1rem;
      margin-top: 40px;
    }
    .footer-links {
      margin-bottom: 18px;
    }
    .footer-links a {
      margin: 0 14px;
      color: var(--white);
      font-weight: 600;
      font-size: 1.05rem;
      transition: color 0.2s;
    }
    .footer-links a:hover {
      color: var(--accent);
    }
    .newsletter {
      margin: 24px auto 0 auto;
      max-width: 340px;
      display: flex;
      gap: 0;
      border-radius: 24px;
      overflow: hidden;
      background: var(--secondary);
      box-shadow: 0 2px 8px 0 rgba(10,22,51,0.06);
    }
    .newsletter input[type="email"] {
      flex: 1;
      padding: 12px 16px;
      border: none;
      font-size: 1rem;
      outline: none;
      background: transparent;
      color: var(--white);
    }
    .newsletter button {
      padding: 12px 22px;
      background: var(--accent);
      color: var(--white);
      border: none;
      font-weight: 700;
      font-size: 1rem;
      cursor: pointer;
      transition: background 0.2s;
    }
    .newsletter button:hover {
      background: var(--accent-light);
      color: var(--white);
    }
    .socials {
      margin-top: 18px;
    }
    .socials a {
      margin: 0 10px;
      color: var(--accent);
      font-size: 1.3rem;
      transition: color 0.2s;
    }
    .socials a:hover {
      color: var(--accent-light);
    }
    @media (max-width: 900px) {
      nav {padding: 18px 16px;}
      .hero-content h1 {font-size: 2.2rem;}
      .features, .club-carousel, .testimonials {flex-direction: column; gap: 24px;}
    }
  </style>
